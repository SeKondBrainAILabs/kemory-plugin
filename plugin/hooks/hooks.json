{
  "description": "Kemory: persistent memory for your coding agent. Hooks whose output is READ — SessionStart, UserPromptSubmit — must stay synchronous: an async hook's stdout is discarded, which would silently kill context injection while still appearing to run. They fail open instead, with every network call capped (3-6s) so a dead network never stalls a session. Capture writes and has no output anyone reads, so it runs async on Stop, PreCompact and SessionEnd. On PreCompact it flushes capture before the context is compacted; it prints nothing and always exits 0, because PreCompact cannot inject context and exit 2 or decision:block would block compaction. The status line, panel and read-only auto-approval live in the separate kemory-panel plugin.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/session-start.sh",
            "timeout": 15,
            "statusMessage": "Loading Kemory memory context..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/prompt-recall.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "(mcp__.*__|[A-Za-z0-9-]+__)kemory_(recall.*|ask|find_similar|get_.*)",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/rate-reminder.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/capture.sh",
            "timeout": 15,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/store-nudge.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/capture.sh",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/capture.sh",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ]
  }
}
