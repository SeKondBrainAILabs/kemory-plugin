{
  "description": "Kemory: persistent memory for Claude Code. Hooks whose output is READ \u2014 SessionStart, UserPromptSubmit, PreToolUse \u2014 must stay synchronous: an async hook's stdout is discarded, which would silently kill context injection and the read-only auto-approval while still appearing to run. They fail open instead, with every network call capped (3-6s) so a dead network never stalls a session. Capture writes and has no output anyone reads, so it runs async on both Stop and SessionEnd. The status line is a function-hooks module (register.ts) named under \"modules\": Claude Code 2.1.267+ loads it, and older Claude Code builds and Grok ignore the key and run the command hooks unchanged.",
  "modules": [
    "./register.ts"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/session-start.sh",
            "timeout": 15,
            "statusMessage": "Loading Kemory memory context..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/prompt-recall.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*__(kemory|s9nmem)_.*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/recall-approve.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*__kemory_(recall.*|ask|find_similar|get_.*)",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/rate-reminder.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/capture.sh",
            "timeout": 15,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/store-nudge.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/capture.sh",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ]
  }
}
